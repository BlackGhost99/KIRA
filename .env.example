# Copie ce fichier en « .env » pour travailler en local. Ne mets JAMAIS de vraies clés dans un fichier
# qui part sur GitHub : sur Render, elles se saisissent dans « Environment ».

# --- Accès (obligatoires) ---
OWNER_PASSWORD=choisis-un-long-mot-de-passe
SECRET_KEY=une-longue-suite-de-caracteres-au-hasard
CRON_TOKEN=un-autre-secret-pour-la-veille-quotidienne
OWNER_NAME=Brice
TIMEZONE=Africa/Libreville

# --- Mémoire durable (Supabase > Connect > Session pooler). Sans cela : fichier local SQLite, effacé à chaque redémarrage Render ---
DATABASE_URL=

# --- Intelligences artificielles : une seule suffit, KIRA bascule automatiquement sur la suivante si l'une tombe ---
LLM_PRIORITY=anthropic,openai,deepseek,groq,ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# OLLAMA_URL=http://mon-serveur:11434   (facultatif : modèle local de secours)

# --- Plafond de dépense : nombre de jetons par jour (entrée + sortie) ---
DAILY_TOKEN_BUDGET=1500000

# --- Recherche web (facultatif : DuckDuckGo est utilisé sans clé) ---
TAVILY_API_KEY=

# --- Évolution : KIRA ouvre des pull requests, ne fusionne jamais ---
# Jeton GitHub « fine-grained » limité au dépôt KIRA : Contents (écriture) + Pull requests (écriture)
GITHUB_TOKEN=
GITHUB_REPO=BlackGhost99/KIRA
GITHUB_BASE_BRANCH=main
