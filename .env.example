# Copie ce fichier en « .env » pour travailler en local. Ne mets JAMAIS de vraies clés dans un fichier
# qui part sur GitHub : sur Render, elles se saisissent dans « Environment ».

# --- Accès (obligatoires) ---
OWNER_PASSWORD=choisis-un-long-mot-de-passe
SECRET_KEY=une-longue-suite-de-caracteres-au-hasard
CRON_TOKEN=un-autre-secret-pour-la-veille-quotidienne
OWNER_NAME=Brice
TIMEZONE=Africa/Libreville
# Origine HTTPS exacte sur Render ; RENDER_EXTERNAL_URL sert de défaut.
PUBLIC_ORIGIN=
COOKIE_SECURE=true
ACCESS_MINUTES=15
SESSION_DAYS=30
REAUTH_SECONDS=300
ALLOW_LEGACY_BEARER=false
# En développement HTTP uniquement : COOKIE_SECURE=false

# --- Mémoire durable (Supabase > Connect > Session pooler). Sans cela : fichier local SQLite, effacé à chaque redémarrage Render ---
DATABASE_URL=

# --- Intelligences artificielles : une seule suffit, KIRA bascule automatiquement sur la suivante si l'une tombe ---
LLM_PRIORITY=anthropic,openai,deepseek,gemini,groq,openrouter,ollama
LLM_ROUTING_MODE=QUALITY
LLM_ECONOMY_ALLOW_PAID=false
LLM_TRUSTED_PROVIDERS=
LLM_TIMEOUT=45
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROQ_FREE_TIER=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_TIER=false
# Déclarer true ci-dessus uniquement pour un compte/projet et modèle réellement gratuits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OLLAMA_URL=http://mon-serveur:11434   (facultatif : ton propre serveur de modèles)

# --- Plafond de dépense : nombre de jetons payants par jour (entrée + sortie ; pas un plafond monétaire) ---
DAILY_TOKEN_BUDGET=1500000

# --- Recherche web (facultatif : DuckDuckGo est utilisé sans clé) ---
TAVILY_API_KEY=

# --- Évolution : KIRA ouvre des pull requests, ne fusionne jamais ---
# Jeton GitHub « fine-grained » limité au dépôt KIRA : Contents (écriture) + Pull requests (écriture)
GITHUB_TOKEN=
GITHUB_REPO=BlackGhost99/KIRA
GITHUB_BASE_BRANCH=main
# Mémoire hybride : endpoint cloud multilingue (optionnel tant que non activé).
# Cloudflare : https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1/embeddings
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT=5
MEMORY_SEMANTIC_THRESHOLD=0.65
